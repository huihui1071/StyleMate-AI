{
  "name": "stylemate-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web"],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "test:web": "npm --workspace apps/web run test",
    "test:api": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "privacy": "python3 scripts/privacy_scan.py",
    "check": "npm run privacy && npm run test:api && npm run test:web && npm run build:web"
  }
}

